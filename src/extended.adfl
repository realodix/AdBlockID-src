! BLOG NETWORK
! ------------------------------------------------------------------------------
||bloggerhub.id/wp-content/uploads/$3p
||brtnetwork.id/wp-content/uploads/$3p
||casakreatif.com/wp-content/uploads/$3p
||photobucket.com/*/Blogger%20Perempuan/banner-$domain=~bloggerperempuan.com
||wp.com/*.photobucket.com/*/Blogger%20Perempuan/banner-$domain=~bloggerperempuan.com
||wp.com/bloggerhub.id/wp-content/uploads/$image,domain=~bloggerhub.id
~emak2blogger.com##[href*="//s.id/EmakBlogger"]:has(img)
!
! QUICK FIX
! ------------------------------------------------------------------------------
! Missing easylist filter on AdGuard
!#if adguard
##[id^="div-gpt-ad"]
!#endif
! https://github.com/AdguardTeam/AdguardFilters/issues/147108#issuecomment-1499379187
! https://github.com/AdguardTeam/AdguardBrowserExtension/issues/2322
!#if adguard
/^https?:\/\/(?:ak\.)?[a-z]{6,12}\.(?:com|net)\/4\/\d{7}/$badfilter,document,popup,subdocument
!#endif
!
! ADGUARD COMPATIBILITY
! ------------------------------------------------------------------------------
! https://github.com/AdguardTeam/FiltersCompiler/issues/164
! https://github.com/AdguardTeam/tsurlfilter/issues/148
0.0.realodix##.btn[onclick]:remove-attr(onclick)
0.0.realodix##body:remove-class(cdk-global-scrollblock)
! https://github.com/AdguardTeam/FiltersCompiler/issues/206
||ex-ample.org^$script,from=ex-ample.com
! https://github.com/AdguardTeam/ExtendedCss/issues/138
0.0.realodix##div.banner:matches-css-before(content: /adv/i)
! https://github.com/AdguardTeam/ExtendedCss/issues/164
0.0.realodix##:matches-path(/^/home/) [data-testid="primaryColumn"]:others()
!
0.0.realodix##+js(prevent-window-open)
