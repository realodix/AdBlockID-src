! BLOG NETWORK
! ------------------------------------------------------------------------------
||bloggerhub.id/wp-content/uploads/$3p
||brtnetwork.id/wp-content/uploads/$3p
||casakreatif.com/wp-content/uploads/$3p
||photobucket.com/*/Blogger%20Perempuan/banner-$domain=~bloggerperempuan.com
||wp.com/*.photobucket.com/*/Blogger%20Perempuan/banner-$domain=~bloggerperempuan.com
||wp.com/bloggerhub.id/wp-content/uploads/$image,domain=~bloggerhub.id
~bloggercrony.com##[href*="//bloggercrony.com"]:has(img)
~bloggerperempuan.com##[href*="//bloggerperempuan.com"]:has(img)
~emak2blogger.com##[href*="//emak2blogger.com"]:has(img)
~emak2blogger.com##[href*="//s.id/EmakBlogger"]:has(img)
!
! QUICK FIX
! ------------------------------------------------------------------------------
! Missing easylist filter on AdGuard
!#if adguard
##[id^="div-gpt-ad"]
!#endif
! https://github.com/AdguardTeam/AdguardFilters/issues/147108#issuecomment-1499379187
! https://github.com/AdguardTeam/AdguardBrowserExtension/issues/2322
!#if adguard
/^https?:\/\/(?:ak\.)?[a-z]{6,12}\.(?:com|net)\/4\/\d{7}/$badfilter,document,popup,subdocument
!#endif
!
! SINGAPORE
! ------------------------------------------------------------------------------
||fintechnews.sg^*-banner-
beritaharian.sg##.max-w-full.min-h-\[80px\].lg\:min-h-\[120px\]:has(> [data-testid="advertisement-element"])
berita.mediacorp.sg##.programtic-ads
stomp.sg##.w-full.min-h-\[120px\]:has(> .w-\[320px\].lg\:w-\[970px\])
tnp.sg##.w-full.min-h-\[50px\].lg\:min-h-\[120px\]
beritaharian.sg##[data-testid="advertisement-element"]
!
! VIETNAM
! ------------------------------------------------------------------------------
vietnam.vn##:matches-path(/id) #ad-post-above
vietnam.vn##:matches-path(/id) #ad-post-between-sections
vietnam.vn##:matches-path(/id) #ad-post-bottom
